                    make_option(c("", "--coverage_groups"), action = "store", type = "character", help = "Grouping of coverage data (comma separated in same order as files)"),
                    make_option(c("-g", "--gtf"), action = "store", type = "character", help = "Reference GTF file (Gencode)"),
                    make_option(c("", "--cache_dir"), action = "store", type = "character", help = "Directory for the cached annotation database [default: user cache directory]"),
                    make_option(c("", "--no_ucsc"), action = "store_true", type = "logical", help = "GTF has non-standard sequences", default = FALSE),
                    make_option(c("-r", "--region"), action = "store", type = "character", help = "Region of interest as chr3:35754106:35856276:+ or gene as ENSMUSG00000037400 or Atp11b"),
                    make_option(c("", "--highlight"), action = "store", type = "character", help = "Region to highlight as 35754106:35856276"),
                    make_option(c("-n", "--normalisation"), action = "store", type = "character", help = "Normalisation options: none, maxpeak, libsize, custom, libsize_maxpeak, custom_maxpeak [default %default]", default = "libsize"),
                    make_option(c("", "--size_factors"), action = "store", type = "character", help = "Size factors for custom normalisation (comma separated)"),
                    make_option(c("", "--scale_y"), action = "store_true", type = "logical", help = "Scale CLIP y-axis for each group independently", default = FALSE),
                    make_option(c("", "--tidy_y_labels"), action = "store", type = "integer", help = "Keep this many y-axis labels (may be slightly more or fewer depending on data)"),
                    make_option(c("", "--flip_x"), action = "store_true", type = "logical", help = "Flip the x-axis for plotting e.g. genes on the negative strand", default = FALSE),
                    make_option(c("-s", "--smoothing"), action = "store", type = "character", help = "Smoothing options: none, rollmean [default %default]", default = "rollmean"),
                    make_option(c("-w", "--smoothing_window"), action = "store", type = "integer", help = "Smoothing window [default %default]", default = 100),
                    make_option(c("-a", "--annotation"), action = "store", type = "character", help = "Annotation options: gene, transcript, none [default %default]", default = "transcript"),
                    make_option(c("", "--size_x"), action = "store", type = "integer", help = "Plot size in mm (x) [default: %default]", default = 210),
                    make_option(c("", "--size_y"), action = "store", type = "integer", help = "Plot size in mm (y) [default: %default]", default = 297),
                    make_option(c("", "--ratios"), action = "store", type = "character", help = "Specify plot ratios in order: xlink track, auxiliary tracks, coverage track, annotation track \
                    (comma separated). Put 0 if any of these track types are absent. \
                    [default: 2 for xlinks, 0.25 for 1 auxiliary track 0.5 for >1, \
                    2 for coverage, 3 for annotation]"),
                    make_option(c("-o", "--output"), action = "store", type = "character", help = "Output plot filename"),
                    make_option(c("", "--verbose"), action = "store_true", type = "logical", help = "Verbose", default = FALSE))

opt_parser = OptionParser(option_list = option_list)
opt <- parse_args(opt_parser)

if(opt$verbose) print(opt)

# ==========
# Helpers for argument checking
# ==========

# Exit with a non-zero status so that pipelines register the failure
Fail <- function(...) {

  message("ERROR: ", ...)
  quit(save = "no", status = 1)

}

SplitArg <- function(x) {

  if(is.null(x)) return(NULL)
  trimws(strsplit(x, ",")[[1]])

}

# Check that a per-file option has one entry per file
CheckLength <- function(values, n, option, files_option) {

  if(!is.null(values) && length(values) != n) {
    Fail("--", option, " has ", length(values), " entries but --", files_option, " has ", n, " files")
  }

}

CheckUnique <- function(values, option) {

  if(anyDuplicated(values)) {
    Fail("--", option, " must be unique, but these are duplicated: ", paste(unique(values[duplicated(values)]), collapse = ", "))
  }

}

# Default track label: file name without directory or extension
LabelFromFile <- function(files, extensions) {

  sub(paste0("\\.(", extensions, ")(\\.gz)?$"), "", basename(files), ignore.case = TRUE)

}

# ==========
# Checks for minimum parameters
# ==========

if(is.null(opt$xlinks)) Fail("No iCLIP bedgraphs supplied")
if(is.null(opt$gtf)) Fail("No Reference GTF supplied")
if(is.null(opt$region)) Fail("region of interest needed to be supplied as e.g. chr3:35754106:35856276:+ or gene as ENSMUSG00000037400 or Atp11b")
if(is.null(opt$output)) Fail("No output defined")
if(!file.exists(opt$gtf)) Fail("GTF file '", opt$gtf, "' does not exist")

if(file.exists(opt$output)) {

 message("WARNING: Output file '", opt$output, "' exists and will be overwritten!")

}

# Check switches

if(!opt$normalisation %in% c("none", "maxpeak", "libsize", "custom", "custom_maxpeak", "libsize_maxpeak")) {

  Fail("normalisation needs to be one of none, maxpeak, libsize, custom, libsize_maxpeak or custom_maxpeak")

}

if(opt$normalisation %in% c("custom", "custom_maxpeak") && is.null(opt$size_factors)) {

  Fail("for custom or custom_maxpeak normalisation size factors need to be provided")

}

if(opt$smoothing == "gaussian") Fail("gaussian smoothing has been removed; please use rollmean or none")

if(!opt$smoothing %in% c("none", "rollmean")) Fail("smoothing needs to be one of none or rollmean")

if(opt$smoothing_window < 1) Fail("--smoothing_window needs to be a positive integer")

if(opt$annotation == "original") Fail("the original annotation style has been removed; please use transcript, gene or none")

if(!opt$annotation %in% c("transcript", "gene", "none")) Fail("annotation needs to be one of transcript, gene or none")

if(!is.null(opt$ratios)) {

  rts <- suppressWarnings(as.numeric(SplitArg(opt$ratios)))
  if(length(rts) != 4 || any(is.na(rts)) || any(rts < 0)) {
    Fail("--ratios, please provide 4 values in order: xlink track, auxiliary tracks, coverage track, annotation track (comma separated). If a track is absent put 0.")
  }

}

if(!is.null(opt$highlight)) {

  highlight <- suppressWarnings(as.integer(strsplit(opt$highlight, ":")[[1]]))
  if(length(highlight) != 2 || any(is.na(highlight))) Fail("--highlight needs to be given as start:end, e.g. 35754106:35856276")

}

# Per-file options: split and check they match the number of files
xlink.files <- SplitArg(opt$xlinks)
track_names <- SplitArg(opt$labels)
xlink.cols <- SplitArg(opt$colours)
xlink.groups <- SplitArg(opt$groups)
size.factors <- SplitArg(opt$size_factors)

CheckLength(track_names, length(xlink.files), "labels", "xlinks")
CheckLength(xlink.cols, length(xlink.files), "colours", "xlinks")
CheckLength(xlink.groups, length(xlink.files), "groups", "xlinks")
if(opt$normalisation %in% c("custom", "custom_maxpeak")) {

  CheckLength(size.factors, length(xlink.files), "size_factors", "xlinks")
  size.factors <- suppressWarnings(as.numeric(size.factors))
  if(any(is.na(size.factors)) || any(size.factors <= 0)) Fail("--size_factors need to be positive numbers")

}

if(is.null(track_names)) track_names <- make.unique(LabelFromFile(xlink.files, "bedgraph|bed"), sep = " ")
CheckUnique(track_names, "labels")

auxiliary.files <- SplitArg(opt$auxiliary)
auxiliary.labels <- SplitArg(opt$auxiliary_labels)
CheckLength(auxiliary.labels, length(auxiliary.files), "auxiliary_labels", "auxiliary")
if(!is.null(auxiliary.files) && is.null(auxiliary.labels)) auxiliary.labels <- make.unique(LabelFromFile(auxiliary.files, "bed"), sep = " ")
CheckUnique(auxiliary.labels, "auxiliary_labels")

coverage.files <- SplitArg(opt$coverage)
coverage.labels <- SplitArg(opt$coverage_labels)
coverage.cols <- SplitArg(opt$coverage_colours)
coverage.groups <- SplitArg(opt$coverage_groups)
CheckLength(coverage.labels, length(coverage.files), "coverage_labels", "coverage")
CheckLength(coverage.cols, length(coverage.files), "coverage_colours", "coverage")
CheckLength(coverage.groups, length(coverage.files), "coverage_groups", "coverage")
if(!is.null(coverage.files) && is.null(coverage.labels)) coverage.labels <- make.unique(LabelFromFile(coverage.files, "bw|bigwig"), sep = " ")
CheckUnique(coverage.labels, "coverage_labels")

missing.files <- c(xlink.files, auxiliary.files, coverage.files)
missing.files <- missing.files[!file.exists(missing.files)]
if(length(missing.files) > 0) Fail("These input files do not exist: ", paste(missing.files, collapse = ", "))

# ==========
# Load libraries
# ==========

suppressPackageStartupMessages(library(GenomeInfoDb)) # seqlevelsStyle; no longer attached by GenomicRanges in newer Bioconductor
suppressPackageStartupMessages(library(rtracklayer))
suppressPackageStartupMessages(library(GenomicFeatures))
suppressPackageStartupMessages(library(ggplot2))
suppressPackageStartupMessages(library(ggthemes))
