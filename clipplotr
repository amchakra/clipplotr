# ==========
# Functions
# ==========

ImportiMapsBedgraph <- function(bedgraph.file) {

  bg <- import.bedGraph(bedgraph.file)

  # Assign strand based on score
  strand(bg)[bg$score < 0] <- "-"
  strand(bg)[bg$score > 0] <- "+"

  # Convert scores to positives now that strands assigned
  bg$score <- abs(bg$score)

  if(!opt$no_ucsc) seqlevelsStyle(bg) <- "UCSC"
  return(bg)

}

SubsetBedgraph <- function(gr, selected.region.gr) {

  xlinks.gr <- unlist(tile(selected.region.gr, width = 1))

  ol <- findOverlaps(xlinks.gr, gr)
  xlinks.gr$score <- 0
  xlinks.gr[queryHits(ol)]$score <- gr[subjectHits(ol)]$score

  return(xlinks.gr)

}

# Find the name used for a chromosome in a file with a different naming style (e.g. chr1 vs 1)
MatchSeqname <- function(chr, available) {

  candidates <- unique(c(chr, sub("^chr", "", chr), paste0("chr", chr)))
  if(chr %in% c("chrM", "M", "MT")) candidates <- c(candidates, "chrM", "MT")
  hit <- candidates[candidates %in% available]
  if(length(hit) == 0) return(NA_character_)
  return(hit[1])

}

# Put the x-axis on the region of interest (reversed if flipped). coord_cartesian is used
# rather than scale limits so that features overlapping the region edges are kept
AddXScale <- function(p) {

  region.xlim <- c(start(region.gr), end(region.gr))

  if(opt$flip_x) {

    p + scale_x_reverse() + coord_cartesian(xlim = rev(region.xlim))

  } else {

    p + scale_x_continuous() + coord_cartesian(xlim = region.xlim)

  }

}

# Number of arrows per transcript/gene: about 15 across the region
ArrowSpacing <- function(region) {

  max(1, round(width(region)/15, -1), round(width(region)/15))

}

# Cached annotation: a TxDb and a gene table, created once per GTF and stored in the user cache
# directory (keyed on file name, size and modification time so a changed GTF is rebuilt)
LoadAnnotation <- function(gtf.file, cache.dir) {

  if(is.null(cache.dir)) cache.dir <- tools::R_user_dir("clipplotr", which = "cache")
  info <- file.info(gtf.file)
  key <- sprintf("%s_%.0f_%.0f", sub("\\.(gtf|gff|gff2)(\\.gz)?$", "", basename(gtf.file), ignore.case = TRUE), info$size, as.numeric(info$mtime))
  txdb.file <- file.path(cache.dir, paste0(key, ".sqlite"))
  genes.file <- file.path(cache.dir, paste0(key, ".genes.rds"))

  if(file.exists(txdb.file) && file.exists(genes.file)) {

    message("INFO: ...loading cached annotation database from ", cache.dir)
    return(list(TxDb = loadDb(txdb.file), genes = readRDS(genes.file)))

  }

  message("INFO: ...creating annotation database for future runs")
  gtf <- import(gtf.file, format = "gtf")
  genes.gr <- gtf[gtf$type == "gene", c("gene_id", "gene_name")]
  make_txdb <- if(requireNamespace("txdbmaker", quietly = TRUE)) txdbmaker::makeTxDbFromGRanges else GenomicFeatures::makeTxDbFromGRanges
  TxDb <- suppressWarnings(suppressMessages(make_txdb(gtf)))

  saved <- tryCatch({
    dir.create(cache.dir, showWarnings = FALSE, recursive = TRUE)
    saveDb(TxDb, txdb.file)
    saveRDS(genes.gr, genes.file)
    TRUE
  }, error = function(e) FALSE)
  if(!saved) message("WARNING: Could not write annotation cache to ", cache.dir, "; it will be rebuilt next time")

  return(list(TxDb = TxDb, genes = genes.gr))

}

# ==========
# Part 0 - Create annotation and get relevant regions in bedgraphs
# ==========

message("INFO: Loading annotation GTF")

annotation <- LoadAnnotation(opt$gtf, opt$cache_dir)
TxDb <- annotation$TxDb
genes.gr <- annotation$genes
if(!opt$no_ucsc) {
  seqlevelsStyle(TxDb) <- "UCSC"
  seqlevelsStyle(genes.gr) <- "UCSC"
}

# Define region
region.coords <- regmatches(opt$region, regexec("^([^:]+):([0-9,]+)[:-]([0-9,]+):([+-])$", opt$region))[[1]]

if(length(region.coords) == 5) {

  region.gr <- GRanges(seqnames = region.coords[2],
                       ranges = IRanges(start = as.integer(gsub(",", "", region.coords[3])),
                                        end = as.integer(gsub(",", "", region.coords[4]))),
                       strand = region.coords[5])
  # Non-standard contigs have no UCSC equivalent, so leave their name as given
  if(!opt$no_ucsc) region.gr <- tryCatch({ seqlevelsStyle(region.gr) <- "UCSC"; region.gr }, error = function(e) region.gr)

} else if(grepl(":", opt$region)) {

  Fail("region '", opt$region, "' should be given as chromosome:start:end:strand, e.g. chr3:35754106:35856276:+")

} else if(grepl("^ENS", opt$region)) {

  # Match gene id with or without the version suffix
  unversioned <- function(x) sub("\\..*$", "", x)
  region.gr <- genes.gr[genes.gr$gene_id == opt$region | unversioned(genes.gr$gene_id) == unversioned(opt$region)]

} else {

  region.gr <- genes.gr[genes.gr$gene_name %in% opt$region]

}

if(length(region.gr) == 0) Fail("region '", opt$region, "' was not found in the GTF")

if(length(region.gr) > 1) {

  Fail("There are more than one genes with the given identifier (", paste(region.gr$gene_id, collapse = ", "), "). Consider specifying the coordinates instead.")

}

if(end(region.gr) < start(region.gr)) Fail("region end is before region start")
if(!as.character(strand(region.gr)) %in% c("+", "-")) Fail("region needs a strand (+ or -)")

seqlevels(region.gr) <- as.character(unique(seqnames(region.gr))) # Cut down to one seqlevels for later comparision
mcols(region.gr) <- NULL

message("INFO: Region is ", seqnames(region.gr), ":", start(region.gr), "-", end(region.gr), ":", strand(region.gr))

if(opt$smoothing == "rollmean" && opt$smoothing_window > width(region.gr)) {

  Fail("--smoothing_window (", opt$smoothing_window, ") is larger than the region (", width(region.gr), " nt)")

}

# ==========
# Part 1a - top half: normalised and smoothed tracks
# ==========

# Read in xlinks
message("INFO: Plotting crosslink track(s)")

if(all(grepl("\\.bedgraph(\\.gz)?$", xlink.files, ignore.case = TRUE))) {

  xlinks <- lapply(xlink.files, ImportiMapsBedgraph)

} else if(all(grepl("\\.bed(\\.gz)?$", xlink.files, ignore.case = TRUE))) {

  xlinks <- lapply(xlink.files, function(x) {

    xlinks.gr <- import.bed(x)
    if(!opt$no_ucsc) seqlevelsStyle(xlinks.gr) <- "UCSC"
    return(xlinks.gr)

  })

} else {

  Fail("Crosslink files need to be all in iCount bedgraph (.bedgraph) or all in bed (.bed) format.")

}

if(opt$normalisation %in% c("custom", "custom_maxpeak")) {

  libSizes <- size.factors

} else {

  libSizes <- sapply(xlinks, function(x) sum(abs(x$score)))

}

# Subset for region and add in 0 count position
xlinks <- lapply(xlinks, function(x) SubsetBedgraph(gr = x, selected.region.gr = region.gr))

# Create datatable for plotting
xlinks.dt <- lapply(seq_along(xlinks), function(i) {

  dt <- as.data.table(xlinks[[i]])
  dt$sample <- track_names[i]
  dt$libSize <- libSizes[i]
  return(dt)

})
xlinks.dt <- rbindlist(xlinks.dt)
xlinks.dt[, sample := factor(sample, levels = track_names)]

# Do the normalisation
message("INFO: ...normalising")
xlinks.dt[, norm := switch(opt$normalisation,
                           "libsize" = (score * 1e6)/libSize,
                           "libsize_maxpeak" = (score * 1e6)/libSize,
                           "maxpeak" = score,
                           "none" = score,
                           "custom" = score/libSize,
                           "custom_maxpeak" = score/libSize),
          by = sample]

# Do the smoothing
message("INFO: ...smoothing")
xlinks.dt[, smoothed := switch(opt$smoothing,
                               "rollmean" = rollmean(norm, opt$smoothing_window, fill = 0),
                               "none" = norm),
          by = sample]

# Assign groups
if(!is.null(xlink.groups)) {

  groups.dt <- data.table(sample = factor(track_names, levels = track_names),
                          grp = factor(xlink.groups, levels = unique(xlink.groups)))
  xlinks.dt <- merge(xlinks.dt, groups.dt, by = "sample")

}

# Now normalise to max peak after smoothing (leave tracks with no signal at 0)
ScaleToMax <- function(x) if(max(x) > 0) x/max(x) else x
if(grepl("maxpeak", opt$normalisation)) {

  if(is.null(xlink.groups)) {
    xlinks.dt[, smoothed := ScaleToMax(smoothed), by = sample]
  } else {
    xlinks.dt[, smoothed := ScaleToMax(smoothed), by = grp]
  }

}

y.label <- switch(opt$normalisation,
                  "libsize" = "Crosslink signal\n(counts per million)",
                  "libsize_maxpeak" = "Crosslink signal\n(counts per million\nnormalised to max peak)",
                  "maxpeak" = "Crosslink signal\n(normalised to max peak)",
                  "none" = "Raw crosslink signal",
                  "custom" = "Crosslink signal\n(custom normalisation)",
                  "custom_maxpeak" = "Crosslink signal\n(custom normalisation\nadjusted to max peak)")

# Plot top half
p.iclip <- ggplot(xlinks.dt) +
  geom_line(aes(x = start, y = smoothed, group = sample, color = sample)) +
  labs(title = opt$region,
       x = "",
       y = y.label,
       colour = "") +
  theme_minimal_grid() + theme(legend.position = "top")

if(is.null(xlink.cols)) {

  p.iclip <- p.iclip + scale_colour_tableau(palette = "Tableau 10")

} else {

  p.iclip <- p.iclip + scale_colour_manual(values = setNames(xlink.cols, track_names))

}

# Facet if groups
if(!is.null(xlink.groups)) {

  p.iclip <- p.iclip +
    facet_grid(grp ~ ., scales = ifelse(opt$scale_y, "free_y", "fixed"), labeller = label_wrap_gen(10)) +
    theme(strip.text.y = element_text(size = 10, angle = 0, hjust = 0))

}

# Add highlight
if(!is.null(opt$highlight)) {

  highlight.dt <- data.table(x1 = highlight[1],
                             x2 = highlight[2],
                             y1 = 0,
                             y2 = Inf) # Assumes not facetted with free scales
  p.iclip <- p.iclip + geom_rect(data = highlight.dt, aes(xmin = x1, xmax = x2, ymin = y1, ymax = y2), fill = "grey50", alpha = 0.2)

}

if(!is.null(opt$tidy_y_labels)) {

  p.iclip <- p.iclip + scale_y_continuous(n.breaks = opt$tidy_y_labels)

}

p.iclip <- AddXScale(p.iclip)

# ==========
# Part 1b - top half: auxiliary file annotation (eg.peaks)
# ==========

if(!is.null(auxiliary.files)) {

  message("INFO: Plotting auxiliary track(s)")

  auxiliary.grl <- lapply(auxiliary.files, function(x) {

    auxiliary.gr <- import.bed(x)
    if(!opt$no_ucsc) seqlevelsStyle(auxiliary.gr) <- "UCSC"
    return(subsetByOverlaps(auxiliary.gr, region.gr, ignore.strand = FALSE))

  })

  auxiliary.dt <- rbindlist(lapply(auxiliary.grl, as.data.table), fill = TRUE)
  auxiliary.dt$exp <- rep(auxiliary.labels, elementNROWS(auxiliary.grl))
  auxiliary.dt[, centre := start + width/2]

  if(nrow(auxiliary.dt) == 0) message("INFO: ...no auxiliary features in the region")

  # Features without a colour (e.g. from a BED6 file mixed with BED9) are drawn in the default dark grey
  use.itemRgb <- "itemRgb" %in% colnames(auxiliary.dt) && nrow(auxiliary.dt) > 0
  if(use.itemRgb) auxiliary.dt[is.na(itemRgb), itemRgb := "grey20"]

  p.auxiliary <- ggplot(auxiliary.dt, aes(x = centre, width = width, y = exp)) +
    scale_y_discrete(breaks = auxiliary.labels,
                     limits = rev(sort(auxiliary.labels))) +
    labs(y = "",
         x = "") +
    theme_minimal_grid()

  if(use.itemRgb) {

    auxiliary.cols <- unique(auxiliary.dt$itemRgb)
    names(auxiliary.cols) <- auxiliary.cols

    p.auxiliary <- p.auxiliary +
      geom_tile(aes(fill = itemRgb)) +
      scale_fill_manual(values = auxiliary.cols) +
      theme(legend.position = "none")

  } else {

    p.auxiliary <- p.auxiliary + geom_tile()

  }

  p.auxiliary <- AddXScale(p.auxiliary)

}


# ==========
# Part 1c - top half: RNA-seq/coverage tracks
# ==========

if(!is.null(coverage.files)) {

  message("INFO: Plotting coverage track(s)")

  coverage.grl <- lapply(coverage.files, function(x) {

    # Only read the region of interest, matching the chromosome naming style of the bigwig
    bw.chr <- MatchSeqname(as.character(seqnames(region.gr)), seqlevels(BigWigFile(x)))

    if(is.na(bw.chr)) {

      message("WARNING: ", seqnames(region.gr), " not found in ", x, "; coverage will be 0")
      gr <- GRanges()

    } else {

      selection <- GRanges(bw.chr, ranges(region.gr))
      gr <- import.bw(x, selection = BigWigSelection(selection))
      seqlevels(gr) <- bw.chr
      seqlevels(gr) <- as.character(seqnames(region.gr))

    }

    return(SubsetBedgraph(gr = gr, selected.region.gr = region.gr))

  })

  coverage.dt <- rbindlist(lapply(coverage.grl, as.data.table))
  coverage.dt$exp <- factor(rep(coverage.labels, elementNROWS(coverage.grl)), levels = coverage.labels)

  if(!is.null(coverage.groups)) {

    coverage_groups.dt <- data.table(exp = factor(coverage.labels, levels = coverage.labels),
                                     grp = factor(coverage.groups, levels = unique(coverage.groups)))
    coverage.dt <- merge(coverage.dt, coverage_groups.dt, by = "exp")

  }

  p.coverage <- ggplot(coverage.dt, aes(x = start, y = score, col = exp)) +
    geom_line() +
    labs(x = "",
         y = "Coverage",
         colour = "") +
    theme_minimal_grid() + theme(legend.position = "bottom") + theme(strip.text.y = element_text(size = 10, angle = 0, hjust = 0))

  if(!is.null(coverage.cols)) {

    p.coverage <- p.coverage + scale_colour_manual(values = setNames(coverage.cols, coverage.labels))

  } else {

    p.coverage <- p.coverage + scale_colour_tableau(palette = "Superfishel Stone")

  }

  if(!is.null(coverage.groups)) {

    p.coverage <- p.coverage + facet_grid(grp ~ ., scales = "free_y", labeller = label_wrap_gen(10)) + theme(strip.text.y = element_text(size = 10, angle = 0, hjust = 0))

  }

  p.coverage <- AddXScale(p.coverage)

}

# ==========
# Part 2 - bottom half: gene structures
# ==========

rosetta.dt <- as.data.table(mcols(genes.gr))[, .(gene_id, gene_name)]
setkey(rosetta.dt, gene_id)

# Split a region into arrow segments covering each of the given features (genes or transcripts)
# so that the intron line shows the direction of transcription
ArrowSegments <- function(features, ids, id.column) {

  region.tiled <- tile(rep(region.gr, length(features)), width = ArrowSpacing(region.gr))

  segments <- GRangesList(lapply(seq_along(features), function(i) {
    gr <- subsetByOverlaps(region.tiled[[i]], features[i], type = "any")
    # Need to adjust for ends
    start(gr[1]) <- start(features[i])
    end(gr[length(gr)]) <- end(features[i])
    return(gr)
  }))

  names(segments) <- ids
  segments.dt <- as.data.table(segments)
  segments.dt[, group := NULL]
  setnames(segments.dt, "group_name", id.column)
  if(as.character(strand(region.gr)) == "-") setnames(segments.dt, c("start", "end"), c("end", "start"))

  return(segments.dt)

}

AnnotationTheme <- function(p) {

  p + theme_minimal_vgrid() +
    theme(axis.line.y = element_blank(), axis.ticks.y = element_blank(), axis.text.y = element_blank(), legend.position = "bottom") +
    labs(x = "Coordinate",
         y = "",
         fill = "")

}

# ==========
# Plot gene kind of structure
# ==========

if(opt$annotation == "gene") {

  message("INFO: Plotting annotation tracks")

  sel.genes <- subsetByOverlaps(genes.gr, region.gr)

  if(length(sel.genes) == 0) {

    message("INFO: ...no genes in the region")
    p.annot <- AnnotationTheme(ggplot())

  } else {

    sel.exons <- exons(TxDb, filter = list(gene_id = sel.genes$gene_id), columns = "gene_id")

    # Region (for arrows)
    sel.region.tiled.dt <- ArrowSegments(sel.genes, sel.genes$gene_id, "gene_id")
    genes.order.dt <- data.table(gene_id = sel.genes$gene_id, group = seq_along(sel.genes))
    sel.region.tiled.dt <- merge(sel.region.tiled.dt, genes.order.dt, by = "gene_id")

    # Exons
    sel.exons.dt <- as.data.table(sel.exons)
    sel.exons.dt$gene_id <- as.character(sel.exons.dt$gene_id) # otherwise type is AsIs
    sel.exons.dt <- merge(sel.exons.dt, genes.order.dt, by = "gene_id")

    # Plot
    p.annot <- ggplot() +
      geom_segment(data = sel.region.tiled.dt, mapping = aes(x = start, xend = end, y = group, yend = group), arrow = arrow(length = unit(0.1, "cm")), colour = "grey50") +
      geom_rect(data = sel.exons.dt, mapping = aes(xmin = start, xmax = end, ymin = group - 0.25, ymax = group + 0.25, fill = gene_id)) +
      scale_fill_tableau()
    p.annot <- AnnotationTheme(p.annot)

  }

  p.annot <- AddXScale(p.annot)

}

# ==========
# Plot transcript kind of structure
# ==========

if(opt$annotation == "transcript") {

  message("INFO: Plotting annotation tracks")

  # Get transcripts that overlap region and order for plotting
  sel.tx_genes <- transcriptsByOverlaps(TxDb, region.gr, columns = c("gene_id", "tx_name"))
  sel.tx_genes <- sel.tx_genes[order(width(sel.tx_genes), decreasing = TRUE)]

  if(length(sel.tx_genes) == 0) {

    message("INFO: ...no transcripts in the region")
    p.annot <- AnnotationTheme(ggplot())

  } else {

    tx.order.dt <- data.table(transcript_id = sel.tx_genes$tx_name,
                              gene_id = sapply(sel.tx_genes$gene_id, "[", 1),
                              centre = start(sel.tx_genes) + width(sel.tx_genes)/2)[, group := 1:.N]
    setkey(tx.order.dt, gene_id)
    tx.order.dt <- rosetta.dt[tx.order.dt]
    tx.order.dt[, gene := paste0(gene_name, " | ", gene_id)]

    # Region (for arrows)
    sel.region.tiled.dt <- ArrowSegments(sel.tx_genes, sel.tx_genes$tx_name, "transcript_id")
    sel.region.tiled.dt <- merge(sel.region.tiled.dt, tx.order.dt, by = "transcript_id")

    # CDS, UTRs and, for transcripts without a CDS (e.g. ncRNA), exons
    # (half-height 0.25 for exons and CDS, 0.15 for UTRs)
    FeatureTable <- function(grl, tx, half.height) {

      grl <- grl[names(grl) %in% tx]
      dt <- as.data.table(grl)
      if(nrow(dt) == 0) return(NULL)
      dt[, group := NULL]
      setnames(dt, "group_name", "transcript_id")
      dt <- merge(dt, tx.order.dt, by = "transcript_id")
      dt[, `:=`(ymin = group - half.height, ymax = group + half.height)]
      return(dt)

    }

    cds_tx <- cdsBy(TxDb, by = "tx", use.names = TRUE)
    noncoding.tx <- sel.tx_genes$tx_name[!sel.tx_genes$tx_name %in% names(cds_tx)]

    features.dt <- rbindlist(list(FeatureTable(exonsBy(TxDb, by = "tx", use.names = TRUE), noncoding.tx, 0.25),
                                  FeatureTable(cds_tx, sel.tx_genes$tx_name, 0.25),
                                  FeatureTable(fiveUTRsByTranscript(TxDb, use.names = TRUE), sel.tx_genes$tx_name, 0.15),
                                  FeatureTable(threeUTRsByTranscript(TxDb, use.names = TRUE), sel.tx_genes$tx_name, 0.15)),
                             fill = TRUE)

    # Plot
    p.annot <- ggplot() +
      geom_segment(data = sel.region.tiled.dt, mapping = aes(x = start, xend = end, y = group, yend = group), arrow = arrow(length = unit(0.1, "cm")), colour = "grey50") +
      geom_rect(data = features.dt, mapping = aes(xmin = start, xmax = end, ymin = ymin, ymax = ymax, fill = gene)) +
      scale_fill_tableau()
    p.annot <- AnnotationTheme(p.annot)

  }

  p.annot <- AddXScale(p.annot)

}

